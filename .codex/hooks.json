{
  "description": "MOT20 repository Beads context and safety hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.codex/hooks/bd-prime.sh",
            "statusMessage": "Loading Beads context",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.codex/hooks/block-dangerous-commands.sh",
            "statusMessage": "Checking command safety",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
