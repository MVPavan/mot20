# Copy to cvat/.env and set the local admin password before starting CVAT.
COMPOSE_PROJECT_NAME=mot20_cvat
CVAT_HOST=127.0.0.1
CVAT_HOST_PORT=8082
# This host path is mounted read-only as /home/django/share/mot20-test.
CVAT_SHARE_PATH=../datasets/MOT20/test
CVAT_ADMIN_USER=admin
CVAT_ADMIN_EMAIL=admin@example.invalid
CVAT_ADMIN_PASSWORD=
# CVAT's default health warning is 90%; keep an explicit 2% safety margin.
CVAT_DISK_USAGE_MAX=98
