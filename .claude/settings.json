{
  "hooks": {
    "PreToolUse": [
      {
        "description": "Block destructive Git commands, Beads store reinitialization, and broad recursive removal",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-commands.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bd-prime.sh"
          }
        ]
      }
    ]
  }
}
